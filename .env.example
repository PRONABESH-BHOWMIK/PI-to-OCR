# Copy to .env.local for local development (never commit a real .env).
# On Vercel, set these in Project → Settings → Environment Variables.

# Groq API key (AI-assisted item extraction).
GROQ_API_KEY=

# Neon / Vercel Postgres. Vercel sets POSTGRES_URL automatically once the
# project is linked to a Postgres database. DATABASE_URL is also accepted for
# local development with any PostgreSQL server.
POSTGRES_URL=
DATABASE_URL=

# Admin panel credentials.
# Generate the password hash with:
#   node scripts/hash-password.js "your password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Per-IP daily limit for the AI endpoint (/api/describe). Default: 50.
RATE_LIMIT_PER_DAY=50
