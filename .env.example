# Copy to .env.local for local development (never commit a real .env).
# On Vercel, set these in Project → Settings → Environment Variables.

# Groq API key (AI-assisted item extraction).
GROQ_API_KEY=

# Neon / Vercel Postgres. Vercel sets POSTGRES_URL automatically once the
# project is linked to a Postgres database. DATABASE_URL is also accepted for
# local development with any PostgreSQL server.
POSTGRES_URL=
DATABASE_URL=

# Admin panel credentials.
# Generate the password hash with:
#   node scripts/hash-password.js "your password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Import Client Document Checklist tool.
# Session secret for tool-user sessions (any long random string).
CHECKLIST_SESSION_SECRET=
# Gmail SMTP for weekly document-expiry reminders.
# Turn on 2-Step Verification in the Gmail account, then create a 16-char
# App Password (Google → Security → App passwords).
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
# Sender address shown on reminder emails (defaults to GMAIL_SMTP_USER).
MAIL_FROM=
# Secret Vercel Cron sends in the x-vercel-cron-secret header to trigger reminders.
CRON_SECRET=

# Per-IP daily limit for the AI endpoint (/api/describe). Default: 50.
RATE_LIMIT_PER_DAY=50
